{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "shell",
            "command": "${workspaceFolder}\\MSVCBuild.bat",
            "args": [
                "--preset",
                "x64-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "shell",
            "command": "${workspaceFolder}\\MSVCBuild.bat",
            "args": [
                "--build",
                "${workspaceFolder}\\out\\build\\x64-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: Configure Debug"
            ],
            "problemMatcher": "$msCompile"
        },

        {
            "label": "CMake: Configure Release",
            "type": "shell",
            "command": "${workspaceFolder}\\MSVCBuild.bat",
            "args": [
                "--preset",
                "x64-release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },

        {
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "${workspaceFolder}\\MSVCBuild.bat",
            "args": [
                "--build",
                "${workspaceFolder}\\out\\build\\x64-release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: Configure Release"
            ],
            "problemMatcher": "$msCompile"
        },

        {
            "label": "Build Debug",
            "dependsOn": [
                "CMake: Build Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },

        {
            "label": "Build Release",
            "dependsOn": [
                "CMake: Build Release"
            ],
            "group": "build"
        }
    ]
}